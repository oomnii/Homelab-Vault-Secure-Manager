# Place this file in the project folder next to run.py (not only in instance/).
# Loaded automatically with override=True so it wins over stale OS environment variables on Windows.

SECRET_KEY=replace-this-secret
FERNET_KEY=

# Optional: override SQLite path (default is instance/vault.db relative to the app).
# DATABASE_URL=sqlite:///C:/path/to/custom.db
SESSION_COOKIE_SECURE=false
FORCE_HTTPS=false
ENABLE_PROXY_FIX=true

# Local login without real email: must be true when SMTP is empty/incomplete (required for OTP step).
OTP_DEV_MODE=true
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3

# Real OTP email — set all of these to working values (app treats missing username/password as "SMTP off").
# Optional: SMTP_ALLOW_NO_AUTH=true for an internal relay that needs no credentials.
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Example for Gmail (do not commit real secrets):
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=you@gmail.com
